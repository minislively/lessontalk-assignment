{
  "name": "lessontalk-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "prisma db push --schema ../../prisma/schema.prisma --accept-data-loss && npm run seed && tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/main.test.ts",
    "test:integration": "tsx --test src/integration.test.ts",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate": "prisma db push --schema ../../prisma/schema.prisma --accept-data-loss",
    "seed": "tsx ../../prisma/seed.ts",
    "db:push": "prisma db push --schema ../../prisma/schema.prisma",
    "postinstall": "prisma generate --schema ../../prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
